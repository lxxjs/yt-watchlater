{
  "manifest_version": 3,
  "name": "YT Watch Later Organizer",
  "version": "1.0.0",
  "description": "Organize your YouTube Watch Later into topic playlists with one click",
  "permissions": ["cookies", "storage", "declarativeNetRequest"],
  "host_permissions": ["https://*.youtube.com/*", "https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "innertube_headers",
        "enabled": true,
        "path": "net_rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
